{
  "name": "byori-studio",
  "version": "0.1.0",
  "description": "Byori Studio - Video editing with creative memory and CLI agents",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "studio": "node scripts/dev.mjs",
    "service": "cargo run --manifest-path src-tauri/Cargo.toml --bin studio-service",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "build": "tsc && vite build",
    "test": "vitest run",
    "verify": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml --lib && python3 -m unittest discover -s scripts -p \"test_*.py\" && npm run build",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "keywords": [
    "video-editor",
    "byoridb",
    "studio"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "lucide-react": "^1.66.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
